# =============================================================================
# HomeLab Network Stack — 环境变量配置
# =============================================================================
# 复制此文件为 .env 并修改: cp .env.example .env
# 所有以 CF_ 开头的变量用于 Cloudflare DDNS
# =============================================================================

# --- 时区 ---
TZ=Asia/Shanghai

# --- WireGuard Easy ---
# 你的公网 IP 或域名 (客户端连接时需要)
WG_HOST=vpn.example.com

# Web UI 密码
# 生成 bcrypt hash:
#   docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw <YOUR_PASSWORD>
#   echo "<YOUR_PASSWORD>" | docker run --rm -i ghcr.io/wg-easy/wg-easy:14 wgpw
# 或使用纯文本 (wg-easy 会自动 hash)
WG_PASSWORD_HASH=$$2a$$12$$coP3UF0I5KTqufI4GZ0tqO6XHhiyzvy/BkHcZm1THqVGLO6tIuBPG

# 客户端允许的 IP 范围
#   0.0.0.0/0, ::/0            → 全局代理 (所有流量走 VPN)
#   172.22.0.0/16, 192.168.0.0/16 → Split Tunnel (仅内网流量走 VPN)
WG_ALLOWED_IPS=0.0.0.0/0, ::/0

# VPN 端口 (UDP)
WG_PORT=51820

# --- Cloudflare DDNS ---
# Cloudflare API Token (推荐使用 Zone.DNS 权限的 API Token)
# 创建地址: https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=your-cloudflare-api-token-here

# 需要动态更新的域名
# 单域名:  example.com
# 多域名:  example.com,*.example.com,sub.example.com
CF_DOMAINS=example.com

# 是否启用 Cloudflare 代理 (CDN)
#   true  = 橙色云朵 (隐藏源 IP，走 CF 代理)
#   false = 灰色云朵 (直连，适合 VPN)
CF_PROXIED=false

# IPv6 检测方式
#   none       = 仅 IPv4
#   local      = 使用本地接口检测 IPv6
#   cloudflare = 通过 Cloudflare 检测公网 IPv6
CF_IP6_PROVIDER=none

# --- 国内镜像配置 (可选) ---
# 如果 Docker Hub 拉取缓慢，可使用以下镜像前缀:
#   docker.m.daocloud.io  (DaoCloud 加速器)
# 注意: ghcr.io 镜像需使用 ghcr.nju.edu.cn 或自建代理
